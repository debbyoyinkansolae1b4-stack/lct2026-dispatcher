# Помощник диспетчера за nginx: nginx принимает запросы на порту 80 и передаёт их контейнеру на 127.0.0.1:8000.
# Контейнер в этом случае запускается с -p 127.0.0.1:8000:8000 (см. README, раздел «На сервере»).
#
# Установка (Ubuntu/Debian):
#   sudo cp deploy/dispatcher.nginx /etc/nginx/sites-available/dispatcher
#   sudo ln -s /etc/nginx/sites-available/dispatcher /etc/nginx/sites-enabled/dispatcher
#   sudo rm -f /etc/nginx/sites-enabled/default
#   sudo nginx -t && sudo systemctl reload nginx
#
# Для своего домена замените «server_name _;» на имя домена; HTTPS — например, через certbot --nginx.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    # Загрузка своего набора заявок (CSV) и файла слоёв пробок.
    client_max_body_size 50m;
    # Расчёт плана длится столько, сколько задано в интерфейсе (20 с по умолчанию, можно минуты), а сверка с OR-Tools
    # считает три решателя подряд. Стандартные 60 с nginx оборвали бы такой ответ ошибкой 504.
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location / {
        proxy_pass http://127.0.0.1:8000;
    }
}
